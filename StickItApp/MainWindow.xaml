<Window x:Class="StickItApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="StickItApp"
        Width="430"
        Height="750"
        MinWidth="430"
        MinHeight="750"
        MaxWidth="430"
        MaxHeight="750"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="8,3" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlSelectedBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuIconStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="30" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MenuLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MenuSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="14,14,14,5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="HeaderTitleMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                    <Setter Property="Foreground" Value="#DC2626" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="{DynamicResource PhoneShellBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="24">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TopBarBrush}"
                    CornerRadius="24,24,0,0"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Button Command="{Binding ToggleMenuCommand}"
                                ToolTip="{DynamicResource MenuLabel}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowMenuButton}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Text="&#xE700;" />
                        </Button>
                        <Button Content="&lt;"
                                Command="{Binding BackCommand}"
                                ToolTip="{DynamicResource BackLabel}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowBackButton}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="8,0">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowMenuButton}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding TopBarTitle}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding CurrentPageTitle}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <Button Command="{Binding ToggleMenuCommand}"
                                ToolTip="{DynamicResource MenuLabel}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HeaderTitleMenuButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowBackButton}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CurrentPageTitle}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE70D;"
                                           Margin="6,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Button Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Content="{Binding ThemeButtonText}"
                            Command="{Binding ToggleThemeCommand}" />

                    <ComboBox Grid.Column="3"
                              Width="58"
                              Height="34"
                              VerticalAlignment="Center"
                              SelectedValue="{Binding SelectedLanguage}"
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="EN" />
                        <ComboBoxItem Content="SR" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource ContentBrush}">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>

            <Border Grid.Row="2"
                    Margin="12,0,12,12"
                    Padding="10,8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource StatusTextStyle}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.RowSpan="3"
                  Panel.ZIndex="100"
                  Visibility="{Binding IsMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="#66000000"
                        MouseDown="DrawerBackdrop_MouseDown" />

                <Border Width="248"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource MenuBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,74,0,12">
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowMapCommand}" Tag="{Binding IsMapSelected}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE774;" />
                                    <TextBlock Style="{StaticResource MenuLabelStyle}" Text="{DynamicResource MapLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowEventsCommand}" Tag="{Binding IsEventsSelected}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE8A7;" />
                                    <TextBlock Style="{StaticResource MenuLabelStyle}" Text="{DynamicResource EventsLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowTypesCommand}" Tag="{Binding IsTypesSelected}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE8FD;" />
                                    <TextBlock Style="{StaticResource MenuLabelStyle}" Text="{DynamicResource TypesLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowTagsCommand}" Tag="{Binding IsTagsSelected}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE8EC;" />
                                    <TextBlock Style="{StaticResource MenuLabelStyle}" Text="{DynamicResource TagsLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowSearchCommand}" Tag="{Binding IsSearchSelected}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE721;" />
                                    <TextBlock Style="{StaticResource MenuLabelStyle}" Text="{DynamicResource SearchLabel}" />
                                </StackPanel>
                            </Button>
                            <Separator Margin="10,10" />
                            <StackPanel Orientation="Horizontal" Margin="14,14,14,5">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Width="22"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="&#xE710;" />
                                <TextBlock Style="{StaticResource MenuSectionLabelStyle}"
                                           Margin="0"
                                           Text="{DynamicResource AddLabel}" />
                            </StackPanel>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NewEventCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE710;" />
                                    <TextBlock Style="{StaticResource MenuLabelStyle}" Text="{DynamicResource NewEventLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NewTypeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE710;" />
                                    <TextBlock Style="{StaticResource MenuLabelStyle}" Text="{DynamicResource NewTypeLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NewTagCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE710;" />
                                    <TextBlock Style="{StaticResource MenuLabelStyle}" Text="{DynamicResource NewTagLabel}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
