<Window x:Class="StickItApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="StickItApp"
        Width="430"
        Height="750"
        MinWidth="430"
        MinHeight="750"
        MaxWidth="430"
        MaxHeight="750"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                    <Setter Property="Foreground" Value="#DC2626" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="{DynamicResource PhoneShellBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="24">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TopBarBrush}"
                    CornerRadius="24,24,0,0"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Button Content="{DynamicResource MenuLabel}"
                                Command="{Binding ToggleMenuCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowMenuButton}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="&lt;"
                                Command="{Binding BackCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowBackButton}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="8,0">
                        <TextBlock Text="{Binding TopBarTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowMenuButton}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Content="{Binding ThemeButtonText}"
                            Command="{Binding ToggleThemeCommand}" />

                    <ComboBox Grid.Column="3"
                              Width="58"
                              Height="34"
                              VerticalAlignment="Center"
                              SelectedValue="{Binding SelectedLanguage}"
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="EN" />
                        <ComboBoxItem Content="SR" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource ContentBrush}">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>

            <Border Grid.Row="2"
                    Margin="12,0,12,12"
                    Padding="10,8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource StatusTextStyle}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.RowSpan="3"
                  Panel.ZIndex="100"
                  Visibility="{Binding IsMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="#66000000"
                        MouseDown="DrawerBackdrop_MouseDown" />

                <Border Width="260"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource MenuBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,76,0,12">
                            <Button Style="{StaticResource MenuButtonStyle}" Content="{DynamicResource MapLabel}" Command="{Binding ShowMapCommand}" />
                            <Button Style="{StaticResource MenuButtonStyle}" Content="{DynamicResource EventsLabel}" Command="{Binding ShowEventsCommand}" />
                            <Button Style="{StaticResource MenuButtonStyle}" Content="{DynamicResource TypesLabel}" Command="{Binding ShowTypesCommand}" />
                            <Button Style="{StaticResource MenuButtonStyle}" Content="{DynamicResource TagsLabel}" Command="{Binding ShowTagsCommand}" />
                            <Button Style="{StaticResource MenuButtonStyle}" Content="{DynamicResource SearchLabel}" Command="{Binding ShowSearchCommand}" />
                            <Button Style="{StaticResource MenuButtonStyle}" Content="{DynamicResource SettingsLabel}" Command="{Binding ShowSettingsCommand}" />
                            <Separator Margin="8,10" />
                            <Button Style="{StaticResource MenuButtonStyle}" Content="{DynamicResource NewEventLabel}" Command="{Binding NewEventCommand}" />
                            <Button Style="{StaticResource MenuButtonStyle}" Content="{DynamicResource NewTypeLabel}" Command="{Binding NewTypeCommand}" />
                            <Button Style="{StaticResource MenuButtonStyle}" Content="{DynamicResource NewTagLabel}" Command="{Binding NewTagCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
