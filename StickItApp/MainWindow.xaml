<Window x:Class="StickItApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="StickItApp"
        Width="430"
        Height="750"
        MinWidth="430"
        MinHeight="750"
        MaxWidth="430"
        MaxHeight="750"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="{DynamicResource PhoneShellBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="24">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TopBarBrush}"
                    CornerRadius="24,24,0,0"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource IconButtonStyle}"
                            Content="Menu"
                            Command="{Binding ToggleMenuCommand}" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="8,0">
                        <TextBlock Text="StickItApp"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Content="{Binding ThemeButtonText}"
                            Command="{Binding ToggleThemeCommand}" />

                    <ComboBox Grid.Column="3"
                              Width="58"
                              Height="34"
                              VerticalAlignment="Center"
                              SelectedValue="{Binding SelectedLanguage}"
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="EN" />
                        <ComboBoxItem Content="SR" />
                    </ComboBox>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding MenuColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Visibility="{Binding IsMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{DynamicResource MenuBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,12">
                        <Button Style="{StaticResource MenuButtonStyle}" Content="Map" Command="{Binding ShowMapCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="Events" Command="{Binding ShowEventsCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="Types" Command="{Binding ShowTypesCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="Tags" Command="{Binding ShowTagsCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="Settings" Command="{Binding ShowSettingsCommand}" />
                        <Separator Margin="8,10" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="New Event" Command="{Binding NewEventCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="New Type" Command="{Binding NewTypeCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="New Tag" Command="{Binding NewTagCommand}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource ContentBrush}">
                    <ContentControl Content="{Binding CurrentPage}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
