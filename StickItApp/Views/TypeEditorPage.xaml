<UserControl x:Class="StickItApp.Views.TypeEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource ContentBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding PageTitle}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" />

            <Button Margin="0,10,0,0"
                    MinHeight="34"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource AutofillExampleLabel}"
                    Command="{Binding AutofillExampleCommand}"
                    Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Text="{DynamicResource CodeLabel}" Margin="0,12,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox Height="32" Padding="8,4" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource NameLabel}" Margin="0,10,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox Height="32" Padding="8,4" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource DescriptionLabel}" Margin="0,10,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox MinHeight="72"
                     Padding="8,4"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource DefaultTypeIconLabel}"
                       Margin="0,12,0,6"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />

            <ItemsControl ItemsSource="{Binding DefaultIconOptions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="58"
                                Height="58"
                                Margin="0,0,8,8"
                                Padding="0"
                                Command="{Binding DataContext.SelectDefaultIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Border x:Name="IconFrame"
                                    Width="54"
                                    Height="54"
                                    Padding="5"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Image Source="{Binding Path}" Stretch="Uniform" />
                            </Border>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="IconFrame" Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="IconFrame" Property="BorderThickness" Value="3" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        MinHeight="68"
                        Margin="0,0,8,0"
                        Padding="12"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="{DynamicResource ImageFormatHintLabel}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Border>

                <Button Grid.Column="1"
                        Width="116"
                        MinHeight="68"
                        Padding="8,2"
                        Content="{DynamicResource ChoosePictureLabel}"
                        Command="{Binding ChangeImageCommand}" />
            </Grid>

            <TextBlock Text="{DynamicResource PreviewLabel}"
                       Margin="0,12,0,4"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />

            <Border MinHeight="92"
                    Padding="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="64"
                            Height="64"
                            Background="{DynamicResource ContentBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Image Source="{Binding IconPreviewPath}"
                                   Stretch="Uniform"
                                   Margin="7"
                                   Visibility="{Binding HasIconPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{DynamicResource NoIconSelectedLabel}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="10"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIconPreview}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Code}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Name}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="34" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button MinHeight="34"
                        Margin="0,0,6,0"
                        Padding="10,2"
                        Content="{DynamicResource ChangeImageLabel}"
                        Command="{Binding ChangeImageCommand}" />
                <Button MinHeight="34"
                        Padding="10,2"
                        Content="{DynamicResource RemoveImageLabel}"
                        Command="{Binding RemoveImageCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding ValidationMessage}"
                       Margin="0,10,0,0"
                       Foreground="#DC2626"
                       TextWrapping="Wrap" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Height="40"
                        Margin="0,0,5,0"
                        ToolTip="{DynamicResource SaveLabel}"
                        Content="{DynamicResource SaveLabel}"
                        Command="{Binding SaveCommand}" />
                <Button Grid.Column="1"
                        Height="40"
                        Margin="5,0,0,0"
                        ToolTip="{DynamicResource CancelLabel}"
                        Content="{DynamicResource CancelLabel}"
                        Command="{Binding CancelCommand}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
