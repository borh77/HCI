<UserControl x:Class="StickItApp.Views.TypeEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{DynamicResource ContentBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <TextBlock Text="{Binding PageTitle}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" />

            <TextBlock Text="{DynamicResource CodeLabel}" Margin="0,12,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox Height="32" Padding="8,4" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource NameLabel}" Margin="0,10,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox Height="32" Padding="8,4" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource DescriptionLabel}" Margin="0,10,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox MinHeight="72"
                     Padding="8,4"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource IconPathLabel}" Margin="0,10,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox Height="32" Padding="8,4" Text="{Binding IconKey, UpdateSourceTrigger=PropertyChanged}" />

            <Border Height="96"
                    Margin="0,10,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Image Source="{Binding IconPreviewPath}" Stretch="Uniform" Margin="8" />
                    <TextBlock Text="{DynamicResource IconPathLabel}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button MinHeight="34"
                        Margin="0,0,6,0"
                        Padding="10,2"
                        Content="{DynamicResource ChangeImageLabel}"
                        Command="{Binding ChangeImageCommand}" />
                <Button MinHeight="34"
                        Padding="10,2"
                        Content="{DynamicResource RemoveImageLabel}"
                        Command="{Binding RemoveImageCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding ValidationMessage}"
                       Margin="0,10,0,0"
                       Foreground="#DC2626"
                       TextWrapping="Wrap" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Height="40"
                        Margin="0,0,5,0"
                        Content="{DynamicResource SaveLabel}"
                        Command="{Binding SaveCommand}" />
                <Button Grid.Column="1"
                        Height="40"
                        Margin="5,0,0,0"
                        Content="{DynamicResource CancelLabel}"
                        Command="{Binding CancelCommand}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
