<UserControl x:Class="StickItApp.Views.EventEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CompactEditorCalendarStyle" TargetType="{x:Type Calendar}">
            <Setter Property="Width" Value="212" />
            <Setter Property="MaxWidth" Value="212" />
            <Setter Property="MaxHeight" Value="235" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CalendarItemStyle" Value="{DynamicResource DarkCalendarItemStyle}" />
            <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource DarkCalendarDayButtonStyle}" />
            <Setter Property="CalendarButtonStyle" Value="{DynamicResource DarkCalendarButtonStyle}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource ContentBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />

            <Button Margin="0,10,0,0"
                    MinHeight="34"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource AutofillExampleLabel}"
                    Command="{Binding AutofillExampleCommand}"
                    Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Text="{DynamicResource CodeLabel}" Margin="0,12,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox Height="32" Padding="8,4" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource NameLabel}" Margin="0,10,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox Height="32" Padding="8,4" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="{DynamicResource CityLabel}" Foreground="{DynamicResource TextBrush}" />
                    <TextBox Height="32" Padding="8,4" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="{DynamicResource CountryLabel}" Foreground="{DynamicResource TextBrush}" />
                    <TextBox Height="32" Padding="8,4" Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource DescriptionLabel}" Margin="0,10,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox MinHeight="72" Padding="8,4" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="{DynamicResource AverageCostLabel}" Foreground="{DynamicResource TextBrush}" />
                    <TextBox Height="32" Padding="8,4" Text="{Binding AverageCost, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="{DynamicResource AttendanceLabel}" Foreground="{DynamicResource TextBrush}" />
                    <ComboBox Height="32"
                              MaxDropDownHeight="150"
                              ItemsSource="{Binding AttendanceOptions}"
                              SelectedItem="{Binding Attendance}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock MinHeight="22"
                                           VerticalAlignment="Center"
                                           Text="{Binding Converter={StaticResource LocalizedDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <CheckBox Content="{DynamicResource IsCharitableLabel}" Margin="0,10,0,0" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding IsCharitable}" />

            <TextBlock Text="{DynamicResource TypeLabel}" Margin="0,10,0,3" Foreground="{DynamicResource TextBrush}" />
            <ComboBox Height="32" ItemsSource="{Binding EventTypes}" SelectedItem="{Binding SelectedType}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizedDisplayConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Margin="0,6,0,0" MinHeight="30" Content="{DynamicResource AddNewTypeLabel}" Command="{Binding AddTypeCommand}" />

            <TextBlock Text="{DynamicResource TagsLabel}" Margin="0,12,0,3" Foreground="{DynamicResource TextBrush}" />
            <Grid>
                <TextBox x:Name="TagSearchTextBox"
                         Height="32"
                         Padding="8,4"
                         ToolTip="{DynamicResource EventEditorTagSearchPlaceholder}"
                         Text="{Binding TagSearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="9,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           IsHitTestVisible="False"
                           Text="{DynamicResource EventEditorTagSearchPlaceholder}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TagSearchTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Height="32" ItemsSource="{Binding AvailableTagsView}" SelectedItem="{Binding SelectedAvailableTag}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource LocalizedDisplayConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Margin="6,0,0,0" MinHeight="32" Content="{DynamicResource AddLabel}" Command="{Binding AddSelectedTagCommand}" />
            </Grid>
            <Button Margin="0,6,0,0" MinHeight="30" Content="{DynamicResource AddNewTagLabel}" Command="{Binding AddTagCommand}" />
            <ItemsControl ItemsSource="{Binding SelectedTags}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,4" Padding="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Converter={StaticResource LocalizedDisplayConverter}}" Foreground="{DynamicResource TextBrush}" />
                                <Button Grid.Column="1" Content="x" Command="{Binding DataContext.RemoveSelectedTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{DynamicResource EventImageLabel}" Margin="0,12,0,3" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource EventImageFallbackHelpLabel}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource EventImageAllowedFormatsLabel}" Margin="0,2,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />

            <Border Margin="0,8,0,0"
                    Padding="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="72"
                            Height="72"
                            Background="{DynamicResource ContentBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Image Source="{Binding EffectiveIconPreviewPath}"
                                   Stretch="UniformToFill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCustomImage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border Background="{Binding TypeColorHex}" CornerRadius="7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasCustomImage}" Value="False" />
                                                    <Condition Binding="{Binding HasEffectiveIconPreview}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding EffectiveIconPreviewPath}" Stretch="Uniform" Margin="8" />
                            </Border>
                            <TextBlock Text="{DynamicResource EventImageFallbackShortLabel}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="10"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEffectiveIconPreview}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedImageFileName}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button MinHeight="32" Margin="0,0,6,0" Content="{DynamicResource ChangeImageLabel}" Command="{Binding ChangeImageCommand}" />
                            <Button MinHeight="32" Content="{DynamicResource RemoveImageLabel}" Command="{Binding RemoveImageCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{DynamicResource CurrentDateLabel}" Margin="0,12,0,3" Foreground="{DynamicResource TextBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DatePicker Grid.Column="0" Margin="0,0,5,0" CalendarStyle="{StaticResource CompactEditorCalendarStyle}" CalendarOpened="DatePicker_CalendarOpened" SelectedDate="{Binding CurrentStart}" />
                <DatePicker Grid.Column="1" Margin="5,0,0,0" CalendarStyle="{StaticResource CompactEditorCalendarStyle}" CalendarOpened="DatePicker_CalendarOpened" SelectedDate="{Binding CurrentEnd}" />
            </Grid>

            <TextBlock Text="{DynamicResource PreviousDatesLabel}" Margin="0,12,0,3" Foreground="{DynamicResource TextBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DatePicker Grid.Column="0" Margin="0,0,4,0" CalendarStyle="{StaticResource CompactEditorCalendarStyle}" CalendarOpened="DatePicker_CalendarOpened" SelectedDate="{Binding PreviousStart}" />
                <DatePicker Grid.Column="1" Margin="4,0,4,0" CalendarStyle="{StaticResource CompactEditorCalendarStyle}" CalendarOpened="DatePicker_CalendarOpened" SelectedDate="{Binding PreviousEnd}" />
                <Button Grid.Column="2" Content="+" Command="{Binding AddPreviousDateCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding PreviousDates}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,4" Padding="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" />
                                <Button Grid.Column="1" Content="x" Command="{Binding DataContext.RemovePreviousDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding ValidationMessage}" Margin="0,10,0,0" Foreground="#DC2626" TextWrapping="Wrap" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Height="40" Margin="0,0,5,0" ToolTip="{DynamicResource SaveLabel}" Content="{DynamicResource SaveLabel}" Command="{Binding SaveCommand}" />
                <Button Grid.Column="1" Height="40" Margin="5,0,0,0" ToolTip="{DynamicResource CancelLabel}" Content="{DynamicResource CancelLabel}" Command="{Binding CancelCommand}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
