<UserControl x:Class="StickItApp.Views.TagEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{DynamicResource ContentBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <TextBlock Text="{Binding PageTitle}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" />

            <TextBlock Text="{DynamicResource CodeLabel}" Margin="0,12,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox Height="32" Padding="8,4" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource NameLabel}" Margin="0,10,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox Height="32" Padding="8,4" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource DescriptionLabel}" Margin="0,10,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox MinHeight="72"
                     Padding="8,4"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource ColorHexLabel}" Margin="0,10,0,3" Foreground="{DynamicResource TextBrush}" />
            <TextBox Height="32" Padding="8,4" Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" />

            <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="36"
                                Height="32"
                                Margin="0,0,7,7"
                                Background="{Binding}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,8,0,0"
                    Padding="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34"
                            Height="34"
                            Background="{Binding ColorHex}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4" />
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="{Binding Code}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Name}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ValidationMessage}"
                       Margin="0,10,0,0"
                       Foreground="#DC2626"
                       TextWrapping="Wrap" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Height="40"
                        Margin="0,0,5,0"
                        ToolTip="{DynamicResource SaveLabel}"
                        Content="{DynamicResource SaveLabel}"
                        Command="{Binding SaveCommand}" />
                <Button Grid.Column="1"
                        Height="40"
                        Margin="5,0,0,0"
                        ToolTip="{DynamicResource CancelLabel}"
                        Content="{DynamicResource CancelLabel}"
                        Command="{Binding CancelCommand}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
