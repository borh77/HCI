<UserControl x:Class="StickItApp.Views.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MapActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBox x:Name="MapFilterTextBox"
                     Height="32"
                     Padding="8,4"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Grid Margin="0,8,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Message}"
                           Foreground="#DC2626"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource MapActionButtonStyle}"
                        ToolTip="{DynamicResource ResetFilterLabel}"
                        Content="{DynamicResource ResetLabel}"
                        Command="{Binding ResetFilterCommand}" />
                <Button Grid.Column="2"
                        Style="{StaticResource MapActionButtonStyle}"
                        ToolTip="{DynamicResource ClearMapLabel}"
                        Content="{DynamicResource ClearMapLabel}"
                        Command="{Binding ClearMapCommand}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource FixedEventMapLabel}"
                       Margin="0,0,0,6"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <Border Width="380"
                    Height="430"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid x:Name="MapDropHost"
                      Width="380"
                      Height="430"
                      AllowDrop="True"
                      Drop="MapSurface_Drop"
                      DragOver="MapSurface_DragOver"
                      ClipToBounds="True">
                    <Image Source="/Assets/Maps/event_map.png"
                           Width="380"
                           Height="430"
                           Stretch="Fill"
                           IsHitTestVisible="False" />

                    <ItemsControl ItemsSource="{Binding MappedEvents}" IsHitTestVisible="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas x:Name="MapSurface"
                                        Width="380"
                                        Height="430"
                                        AllowDrop="True"
                                        Background="Transparent"
                                        ClipToBounds="True"
                                        Drop="MapSurface_Drop"
                                        DragOver="MapSurface_DragOver" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="48"
                                        Height="48"
                                        Padding="0"
                                        ToolTip="{Binding Name}"
                                        Command="{Binding DataContext.SelectEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        PreviewMouseLeftButtonDown="EventCard_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="EventCard_PreviewMouseMove">
                                    <Grid>
                                        <Border Background="{Binding TypeColorHex}" CornerRadius="8" />
                                        <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="6" />
                                        <Border Background="#AA000000" VerticalAlignment="Bottom" CornerRadius="0,0,8,8">
                                            <TextBlock Text="{Binding ShortCode}"
                                                       Foreground="White"
                                                       FontSize="8"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="250"
                            Margin="10"
                            Padding="10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel DataContext="{Binding SelectedEvent}">
                            <TextBlock Text="{Binding Id}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding Location}" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button Style="{StaticResource MapActionButtonStyle}" ToolTip="{DynamicResource DetailsLabel}" Content="{DynamicResource DetailsLabel}" Command="{Binding DetailsCommand}" />
                                <Button Style="{StaticResource MapActionButtonStyle}" ToolTip="{DynamicResource EditLabel}" Content="{DynamicResource EditLabel}" Command="{Binding EditCommand}" />
                                <Button Style="{StaticResource MapActionButtonStyle}" ToolTip="{DynamicResource DeleteLabel}" Content="{DynamicResource DeleteLabel}" Command="{Binding DeleteCommand}" />
                                <Button Style="{StaticResource MapActionButtonStyle}" Content="{DynamicResource BackToListLabel}" Command="{Binding BackToListCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <Border x:Name="UnplacedDropZone"
                Grid.Row="2"
                MinHeight="92"
                Margin="0,8,0,0"
                Padding="6"
                AllowDrop="True"
                Drop="UnplacedDropZone_Drop"
                DragOver="UnplacedDropZone_DragOver"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding UnplacedEvents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="118"
                                    Height="70"
                                    Margin="0,0,8,0"
                                    Padding="6"
                                    Background="{DynamicResource ContentBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    PreviewMouseLeftButtonDown="EventCard_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="EventCard_PreviewMouseMove">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="30" Height="30" Background="{Binding TypeColorHex}" CornerRadius="6">
                                        <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="4" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" MaxHeight="34" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
