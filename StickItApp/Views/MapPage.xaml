<UserControl x:Class="StickItApp.Views.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MapActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MapRoot" Background="{DynamicResource ContentBrush}" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBox x:Name="MapFilterTextBox"
                     Height="32"
                     Padding="8,4"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Grid Margin="0,8,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Message}"
                           Foreground="#DC2626"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource MapActionButtonStyle}"
                        ToolTip="{DynamicResource ResetFilterLabel}"
                        Content="{DynamicResource ResetLabel}"
                        Command="{Binding ResetFilterCommand}" />
                <Button Grid.Column="2"
                        Style="{StaticResource MapActionButtonStyle}"
                        ToolTip="{DynamicResource ClearMapLabel}"
                        Content="{DynamicResource ClearMapLabel}"
                        Command="{Binding ClearMapCommand}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource FixedEventMapLabel}"
                       Margin="0,0,0,6"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <Border Width="376"
                    Height="320"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid x:Name="MapDropHost"
                      Width="376"
                      Height="320"
                      AllowDrop="True"
                      Drop="MapSurface_Drop"
                      DragOver="MapSurface_DragOver"
                      ClipToBounds="True">
                    <Image Source="/Assets/Maps/event_map.png"
                           Width="376"
                           Height="320"
                           Stretch="Fill"
                           IsHitTestVisible="False" />

                    <ItemsControl ItemsSource="{Binding MappedEvents}" IsHitTestVisible="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas x:Name="MapSurface"
                                        Width="376"
                                        Height="320"
                                        AllowDrop="True"
                                        Background="Transparent"
                                        ClipToBounds="True"
                                        Drop="MapSurface_Drop"
                                        DragOver="MapSurface_DragOver" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="48"
                                        Height="48"
                                        Padding="0"
                                        ToolTip="{Binding Name}"
                                        Command="{Binding DataContext.SelectEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        PreviewMouseLeftButtonDown="EventCard_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="EventCard_PreviewMouseMove">
                                    <Grid>
                                        <Border Background="{Binding TypeColorHex}" CornerRadius="8" />
                                        <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="6" />
                                        <Border Background="#AA000000" VerticalAlignment="Bottom" CornerRadius="0,0,8,8">
                                            <TextBlock Text="{Binding ShortCode}"
                                                       Foreground="White"
                                                       FontSize="8"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="300"
                            MaxHeight="210"
                            Margin="16"
                            Padding="10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" DataContext="{Binding SelectedEvent}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Id}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42" />
                                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Location}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        Margin="4,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Top"
                                        Content="X"
                                        ToolTip="{DynamicResource BackToMapLabel}"
                                        Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Grid>
                            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button Style="{StaticResource MapActionButtonStyle}" ToolTip="{DynamicResource DetailsLabel}" Content="{DynamicResource DetailsLabel}" Command="{Binding DetailsCommand}" />
                                <Button Style="{StaticResource MapActionButtonStyle}" ToolTip="{DynamicResource EditLabel}" Content="{DynamicResource EditLabel}" Command="{Binding EditCommand}" />
                                <Button Style="{StaticResource MapActionButtonStyle}" ToolTip="{DynamicResource DeleteLabel}" Content="{DynamicResource DeleteLabel}" Command="{Binding DeleteCommand}" />
                                <Button Style="{StaticResource MapActionButtonStyle}" Content="{DynamicResource BackToMapLabel}" Command="{Binding CloseDetailsCommand}" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{DynamicResource MapDragDropInstructionLabel}"
                   Margin="0,4,0,3"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />

        <Border x:Name="UnplacedDropZone"
                Grid.Row="3"
                Height="140"
                Margin="0,0,0,0"
                Padding="6"
                AllowDrop="True"
                Drop="UnplacedDropZone_Drop"
                DragOver="UnplacedDropZone_DragOver"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Width="24"
                        Margin="0,0,5,16"
                        Padding="0"
                        VerticalAlignment="Center"
                        Content="&lt;"
                        Click="EventTrayScrollLeft_Click" />
                <ScrollViewer x:Name="EventTrayScrollViewer"
                              Grid.Column="1"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              Height="124"
                              Padding="0,0,0,2"
                              PreviewMouseWheel="EventTrayScrollViewer_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding UnplacedEvents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="118"
                                    Height="106"
                                    Margin="0,0,8,0"
                                    Padding="6"
                                    Background="{DynamicResource ContentBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    PreviewMouseLeftButtonDown="EventCard_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="EventCard_PreviewMouseMove"
                                    Cursor="Hand">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <Border Width="54" Height="54" Background="{Binding TypeColorHex}" CornerRadius="10" HorizontalAlignment="Center">
                                        <Grid>
                                            <Image Source="{Binding IconPath}"
                                                   Stretch="Uniform"
                                                   Margin="8">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconPath}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding Initial}"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconPath}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               Margin="0,8,0,0"
                                               Width="104"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               LineHeight="13"
                                               MaxHeight="34" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="2"
                        Width="24"
                        Margin="5,0,0,16"
                        Padding="0"
                        VerticalAlignment="Center"
                        Content="&gt;"
                        Click="EventTrayScrollRight_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
