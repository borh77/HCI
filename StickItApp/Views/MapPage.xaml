<UserControl x:Class="StickItApp.Views.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="MapActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style x:Key="MapAddButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EventIconFrameStyle" TargetType="Border">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{Binding TypeColorHex}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="EventIconImageStyle" TargetType="Image">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Margin" Value="8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconPath}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EventIconInitialStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconPath}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MapMarkerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MapRoot" Background="{DynamicResource ContentBrush}" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid>
                <TextBox x:Name="MapFilterTextBox"
                         Height="32"
                         Padding="8,4,32,4"
                         ToolTip="{DynamicResource EventMapPlaceholder}"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="9,0,32,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           IsHitTestVisible="False"
                           Text="{DynamicResource EventMapPlaceholder}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=MapFilterTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Width="24"
                        Height="24"
                        Margin="0,0,5,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="X"
                        FontSize="11"
                        ToolTip="{DynamicResource ResetFilterLabel}"
                        Command="{Binding ClearFilterCommand}"
                        Visibility="{Binding HasFilterText, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <Border Margin="0,5,0,3"
                    Padding="8,5"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="#DC2626"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Message}"
                               Foreground="#DC2626"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Width="24"
                            Height="24"
                            Margin="6,0,0,0"
                            Padding="0"
                            Content="X"
                            FontSize="11"
                            Command="{Binding ClearMessageCommand}" />
                </Grid>
            </Border>

            <Grid Margin="0,4,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Style="{StaticResource MapActionButtonStyle}"
                        ToolTip="{DynamicResource ResetFilterLabel}"
                        Command="{Binding ResetFilterCommand}"
                        Visibility="{Binding IsResetVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,5,0" />
                        <TextBlock Text="{DynamicResource ResetLabel}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource MapActionButtonStyle}"
                        ToolTip="{DynamicResource ClearMapLabel}"
                        Command="{Binding ClearMapCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,0,5,0" />
                        <TextBlock Text="{DynamicResource ClearMapLabel}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource FixedEventMapLabel}"
                       Margin="0,0,0,6"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <Border Width="376"
                    Height="320"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid x:Name="MapDropHost"
                      Width="376"
                      Height="320"
                      AllowDrop="True"
                      Drop="MapSurface_Drop"
                      DragOver="MapSurface_DragOver"
                      ClipToBounds="True">
                    <Image Source="/Assets/Maps/event_map.png"
                           Width="376"
                           Height="320"
                           Stretch="Fill"
                           IsHitTestVisible="False" />

                    <ItemsControl ItemsSource="{Binding MappedEvents}" IsHitTestVisible="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas x:Name="MapSurface"
                                        Width="376"
                                        Height="320"
                                        AllowDrop="True"
                                        Background="Transparent"
                                        ClipToBounds="True"
                                        Drop="MapSurface_Drop"
                                        DragOver="MapSurface_DragOver" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MapMarkerButtonStyle}"
                                        ToolTip="{Binding Name}"
                                        Command="{Binding DataContext.SelectEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        PreviewMouseLeftButtonDown="EventCard_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="EventCard_PreviewMouseMove">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="56"
                                                Height="56"
                                                CornerRadius="11">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource EventIconFrameStyle}">
                                                    <Setter Property="Background" Value="{Binding TypeColorHex}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCustomImage}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ContentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid ClipToBounds="True">
                                                <Image Source="{Binding CustomImagePath}"
                                                       Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCustomImage}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Image Source="{Binding TypeIconPath}">
                                                    <Image.Style>
                                                        <Style TargetType="Image" BasedOn="{StaticResource EventIconImageStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCustomImage}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding Initial}"
                                                           Style="{StaticResource EventIconInitialStyle}" />
                                            </Grid>
                                        </Border>
                                        <Border Margin="0,3,0,0"
                                                Padding="4,1"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <TextBlock Text="{Binding ShortCode}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       MaxWidth="54"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="300"
                            MaxHeight="210"
                            Margin="16"
                            Padding="10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" DataContext="{Binding SelectedEvent}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Id}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42" />
                                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Location}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        Margin="4,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Top"
                                        Content="X"
                                        ToolTip="{DynamicResource BackToMapLabel}"
                                        Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Grid>
                            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button Style="{StaticResource MapActionButtonStyle}" ToolTip="{DynamicResource DetailsLabel}" Command="{Binding DetailsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource DetailsLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MapActionButtonStyle}" ToolTip="{DynamicResource EditLabel}" Command="{Binding EditCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource EditLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MapActionButtonStyle}" ToolTip="{DynamicResource DeleteLabel}" Command="{Binding DeleteCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource DeleteLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MapActionButtonStyle}" Command="{Binding CloseDetailsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource BackToMapLabel}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,14,14"
                            Panel.ZIndex="20"
                            Style="{StaticResource MapAddButtonStyle}"
                            Content="+"
                            ToolTip="{DynamicResource AddEventLabel}"
                            Command="{Binding AddEventCommand}" />
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{DynamicResource MapDragDropInstructionLabel}"
                   Margin="0,4,0,3"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />

        <Border x:Name="UnplacedDropZone"
                Grid.Row="3"
                Height="140"
                Margin="0,0,0,0"
                Padding="6"
                AllowDrop="True"
                Drop="UnplacedDropZone_Drop"
                DragOver="UnplacedDropZone_DragOver"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Width="24"
                        Margin="0,0,5,16"
                        Padding="0"
                        VerticalAlignment="Center"
                        Content="&lt;"
                        Click="EventTrayScrollLeft_Click" />
                <ScrollViewer x:Name="EventTrayScrollViewer"
                              Grid.Column="1"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              Height="124"
                              Padding="0,0,0,2"
                              PreviewMouseWheel="EventTrayScrollViewer_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding UnplacedEvents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="112"
                                    Height="106"
                                    Margin="0,0,6,0"
                                    Padding="6"
                                    Background="{DynamicResource ContentBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    PreviewMouseLeftButtonDown="EventCard_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="EventCard_PreviewMouseMove"
                                    Cursor="Hand">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource EventIconFrameStyle}">
                                                <Setter Property="Background" Value="{Binding TypeColorHex}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCustomImage}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ContentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding CustomImagePath}"
                                                   Stretch="UniformToFill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCustomImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <Image Source="{Binding TypeIconPath}">
                                                <Image.Style>
                                                    <Style TargetType="Image" BasedOn="{StaticResource EventIconImageStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCustomImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding Initial}"
                                                       Style="{StaticResource EventIconInitialStyle}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               Margin="0,8,0,0"
                                               Width="100"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               LineHeight="13"
                                               MaxHeight="34" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="2"
                        Width="24"
                        Margin="5,0,0,16"
                        Padding="0"
                        VerticalAlignment="Center"
                        Content="&gt;"
                        Click="EventTrayScrollRight_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
